#!/usr/bin/env bash
# ==============================================================================
# ApoioFala — pré-remoção do pacote .deb
# Encerra instâncias em execução antes da desinstalação/upgrade.
# ==============================================================================
set -e

echo "[prerm] Encerrando instâncias do ApoioFala em execução..."
pkill -f '/opt/apoiofala/electron/apoiofala' 2>/dev/null || true
sleep 1
pkill -f '/opt/apoiofala/venv/bin/uvicorn' 2>/dev/null || true
pkill -f 'uvicorn app.main:app' 2>/dev/null || true

exit 0