# CAA-Lab - Variáveis de Ambiente

# Configurações do Servidor
APP_NAME=CAA-Lab
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
SECRET_KEY=caa-lab-insecure-secret-key-change-in-production

# Banco de Dados
DATABASE_URL=sqlite:///./data/caa_lab.db

# Configurações de Voz e Idioma
DEFAULT_LANGUAGE=pt-BR
DEFAULT_VOICE_RATE=1.0

# Armazenamento e Diretórios
DATA_DIR=./data
ASSETS_DIR=./assets

# Síntese de Voz
# Motor do TTS no backend: auto (voz neural Microsoft → espeak-ng offline),
# neural (apenas online) ou espeak (100% offline, voz robotizada).
TTS_ENGINE=auto
